# Ollama settings
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.2:3b
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.0

# FastAPI server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
LOG_LEVEL=INFO
RATE_LIMIT_PER_MINUTE=30

# CORS (allow frontend origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

KG_DATA_PATH=knowledge_graphs

# Set to true to register /debug/chat (returns raw tracebacks - dev only)
DEBUG=false

# Set to true to force a full master-index rescan on every startup
# (normally the index only re-scans files that are new or changed)
FORCE_REBUILD=false
